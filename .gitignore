# Rider
# Covers JetBrains Rider generated files, IDE settings, and temporary files.
# https://www.jetbrains.com/help/rider/Project_and_IDE_Settings.html
#
# User-specific files
*.idea/workspace.xml
*.idea/tasks.xml
*.idea/dictionaries
*.idea/shelf
*.idea/.idea # Very important for Rider, contains user specific settings

# Rider local settings
.idea/riderModule.iml
*.idea/modules.xml # Contains paths to .iml files, which can be user-specific

# Rider auto-generated files
*.iml

# Rider local history
.idea/localMightBeMoved/

# Sensitive information (if stored in .idea, though it shouldn't be)
# .idea/dataSources/
# .idea/dataSources.ids/
# .idea/dataSources.local.xml

# Rider Code Coverage reports
# Rider-generated coverage reports might be in various formats or locations
# Add specific patterns if you know them, e.g.,
# coverage-report/
# **/*.coverage

# NuGet Packages
# Exclude packages folder, as these should be restored via package management.
# However, it's often better to let NuGet handle this with a packages.config or PackageReference in the .csproj file.
# If you're using a solution-level packages folder:
# packages/*
# !packages/repositories.config
# If you're using project-level packages folders (less common now):
# **/packages/*
# !**/packages/repositories.config
# For .NET Core and later, NuGet packages are typically restored to a global cache,
# so explicitly ignoring 'packages' folder in the project might not be necessary
# if you are not checking in the 'packages' folder itself.

# NuGet/Paket temporary files
*.nupkg
*.snupkg
# NuGet symbol server caching
.nuget/packages/
# NuGet v3 Global Package Cache
# %userprofile%\.nuget\packages on Windows
# ~/.nuget/packages on Mac/Linux
# These are global and shouldn't be in your project repo anyway.

# Paket dependencies
.paket/paket.exe
paket-files/

# Fake build script files
.fake/

# Docker
# Ignore docker-compose override files
docker-compose.override.yml
docker-compose.override.yaml
# Ignore Docker build context specific files
.dockerignore
# If you build Docker images within your project and don't want to commit them
# (though typically you'd push to a registry)
# *.tar
# *.tar.gz
# Dockerfile.local (if you use local variants not for general use)

# Environment files
.env
.env.*
!.env.example
!.env.template

# Local configuration files
appsettings.Development.json
secrets.json
user-secrets/
# For ASP.NET Core user secrets, the UserSecretsId in the .csproj is enough.
# The actual secrets are stored outside the project directory.

# Publish folder
publish/

# Rider specific
.idea/

# Entity Framework
# Migrations are usually committed, but if you have local-only migration states or tools
# __EFMigrationsHistory/ # This is usually in the database, not as files

# Node.js (if you're using it for frontend or build tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json # If you prefer not to commit it, though generally recommended
yarn.lock # If you prefer not to commit it, though generally recommended
dist/
out/
build/
.npm/

# Test files and directories
*.testsettings
*.testrunconfig
*.trx

# Output from test runners
TestResults/

# Rider specific settings
.idea/.idea.*/.idea/workspace.xml
.idea/.idea.*/.idea/shelf/

# Rider solution-specific settings (can be shared if desired, but often user-specific)
# *.sln.DotSettings

# Rider project-specific settings (can be shared if desired)
# *.csproj.DotSettings

# Rider temp files
*.tmp
*~
# If you have other specific files or directories generated by your tools or workflow,
# add them here.
